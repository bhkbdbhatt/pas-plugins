# ---------------------------------------------------------------------------
# PAS Plugins monorepo - environment template.  Copy to `.env` and adjust.
# Every value has a safe development default; nothing here is a real secret.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
PAS_ENV=development                 # development | staging | production
PAS_LOG_LEVEL=INFO
PAS_LOG_FORMAT=json                 # json | console

# --- Storage ---------------------------------------------------------------
PAS_DATABASE_URL=postgresql+asyncpg://pas:pas@localhost:5432/pas_plugins
PAS_REDIS_URL=redis://localhost:6379/0
PAS_FACTORY_BACKEND=memory          # memory | redis  (in-memory keeps unit tests hermetic)

# --- Identity (Keycloak / any OIDC provider) -------------------------------
PAS_OIDC_ISSUER=https://keycloak.local/realms/pas-plugins
PAS_OIDC_AUDIENCE=pas-plugins-api
PAS_OIDC_JWKS_URL=https://keycloak.local/realms/pas-plugins/protocol/openid-connect/certs
PAS_OIDC_REQUIRED=false             # true in staging/production
PAS_TENANT_HEADER=X-PAS-Tenant-Id
PAS_API_KEY_HEADER=X-PAS-Api-Key

# --- Plugin 1: API Gateway + MCP Orchestrator ------------------------------
P1_GATEWAY_NAME=pas-ai-gateway
P1_GATEWAY_POLICY=per-tenant-rls
P1_MCP_ENABLED=true
P1_MCP_TRANSPORT=streamable-http
P1_WORKFLOW_ENGINE=local            # local | temporal
P1_DEFAULT_PAS_VENDOR=majesco-lifeplus

# --- Plugin 2: IFRS 17 / Regulatory Automation -----------------------------
P2_FUNCTIONAL_CURRENCY=USD
P2_DISCOUNT_RATE_BASIS=locked-in     # locked-in | updated
P2_MONTE_CARLO_PATHS=2000
P2_MONTE_CARLO_SEED=20260101
P2_MAX_WORKERS=4

# --- Plugin 3: Accelerated Underwriting ------------------------------------
P3_AUTO_DECIDE_THRESHOLD=0.90
P3_FAST_TRACK_THRESHOLD=0.65
P3_MODEL_VERSION=auw-gbm-1.4.0
P3_DRIFT_PSI_THRESHOLD=0.20

# --- Plugin 4: Low-Code Product Configuration ------------------------------
P4_REQUIRE_APPROVAL=true
P4_SANDBOX_MAX_POLICIES=5000
P4_ALLOWED_DEPLOY_STATES=AL,AZ,CA,CT,DE,FL,GA,IL,IN,IA,KS,LA,ME,MD,MA,MI,MN,MS,MO,MT,NE,NV,NH,NJ,NM,NY,NC,ND,OH,OK,OR,PA,RI,SC,SD,TN,TX,UT,VT,VA,WA,WV,WI,WY

# --- Plugin 5: Embedded Distribution ---------------------------------------
P5_QUOTE_SLA_MS=500
P5_BIND_SLA_MS=2000
P5_SETTLEMENT_CURRENCY=USD

# --- Plugin 6: Data Mesh ---------------------------------------------------
P6_FEATURE_STORE=online
P6_PII_MASKING=enforce               # enforce | observe | off
P6_LINEAGE_ENABLED=true
P6_FEATURE_TTL_SECONDS=900

# --- Plugin 7: Blockchain Policy Lifecycle ---------------------------------
P7_LEDGER_BACKEND=inmemory           # inmemory | fabric
P7_CHAIN=pas-policy-records
P7_CHANNEL=pas-policy-records
P7_FABRIC_CONFIG=/etc/pas/fabric.yaml
